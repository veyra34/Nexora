# =============================================================================
# NEXORA ENVIRONMENT VARIABLES
# Copy this file to Mobile/.env and provide your actual API keys
# =============================================================================

# Supabase Configuration
# Obtain from Supabase Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Gemini AI API Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
